# Salin menjadi .env lalu isi, jangan pernah di-commit.
#   cp .env.contoh .env

# Kunci penanda tangan cookie sesi. Buat dengan: openssl rand -hex 32
SECRET_KEY=

# Kosongkan untuk memakai SQLite di dalam volume (bawaan, cocok untuk satu VPS).
# Untuk Postgres, jalankan dengan --profile postgres lalu isi:
#   DATABASE_URL=postgresql://finger:SANDI@postgres:5432/finger
DATABASE_URL=

# Hanya dipakai bila memakai profil postgres
POSTGRES_DB=finger
POSTGRES_USER=finger
POSTGRES_PASSWORD=
